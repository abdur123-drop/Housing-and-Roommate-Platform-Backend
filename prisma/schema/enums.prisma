enum PropertyType {
  APARTMENT
  HOUSE
  BUILDING
  CONDO
  VILLA
  OTHER
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum UnitStatus {
  AVAILABLE
  PARTIALLY_OCCUPIED
  FULLY_OCCUPIED
  MAINTENANCE
  UNAVAILABLE
}

enum RoomType {
  PRIVATE
  SHARED
  MASTER
  STUDIO
}

enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
  UNAVAILABLE
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  RESERVED
  OCCUPIED
}

enum ViewingRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum LeaseStatus {
  PENDING
  ACTIVE
  EXPIRED
  TERMINATED
}

enum RentPaymentStatus {
  PENDING
  // Handed off to the payment provider; awaiting the webhook that settles it.
  PROCESSING
  PAID
  LATE
  FAILED
  REFUNDED
  // Voided before settlement. Financial rows are never hard- or soft-deleted;
  // this is how a payment row is retired while preserving history.
  CANCELLED
}

/// Real payment providers only - there is deliberately no MANUAL/FAKE member.
enum PaymentProvider {
  STRIPE
  BKASH
  SSLCOMMERZ
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  MOBILE_PAYMENT
  OTHER
}

