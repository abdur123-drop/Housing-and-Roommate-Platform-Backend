// ---------------------------------------------------------------------------
// 20. refresh_tokens
//
// Persistent refresh-token store. Refresh tokens are stateful precisely so that
// logout and revocation are real: a stateless refresh token cannot be withdrawn.
//
// SECURITY: `token_hash` holds a SHA-256 hash of the raw token, never the token
// itself. A database leak therefore yields nothing usable. SHA-256 (not bcrypt)
// is the right choice here because the token is already high-entropy random
// data -- and bcrypt silently truncates input at 72 bytes, which a signed JWT
// exceeds.
//
// No deleted_at: this table has its own lifecycle column, `revoked_at`.
// ---------------------------------------------------------------------------
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Set when this token is rotated out, forming an audit chain. A request that
  /// presents an already-rotated token is a replay: see reuse detection in
  /// auth.service.ts.
  replacedByTokenId String? @unique @map("replaced_by_token_id") @db.Uuid

  /// Best-effort request context, useful when investigating a reuse incident.
  createdByIp String? @map("created_by_ip")
  userAgent   String? @map("user_agent")

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}
