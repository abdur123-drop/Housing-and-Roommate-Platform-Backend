// ---------------------------------------------------------------------------
// 15. rent_payments
// ---------------------------------------------------------------------------
// A rent payment row is financial history: it is never hard-deleted and has no
// deleted_at. Retire one by moving it to CANCELLED / REFUNDED instead.
model RentPayment {
  id            String            @id @default(uuid()) @db.Uuid
  leaseId       String            @map("lease_id") @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  amount        Decimal           @db.Decimal(12, 2)
  currency      String            @default("USD") @db.Char(3)
  dueDate       DateTime          @map("due_date") @db.Timestamptz(6)
  paidAt        DateTime?         @map("paid_at") @db.Timestamptz(6)
  status        RentPaymentStatus @default(PENDING)
  paymentMethod PaymentMethod?    @map("payment_method")
  transactionId String?           @unique @map("transaction_id")

  // ---- Real payment-provider integration (Stripe / bKash / SSLCommerz) ----
  // All nullable: a row exists from the moment rent is due, long before any
  // provider interaction happens.
  provider           PaymentProvider?
  /// Provider's authoritative payment id (e.g. Stripe PaymentIntent `pi_...`).
  /// UNIQUE so a replayed webhook cannot create or settle a second row.
  providerPaymentId  String?          @unique @map("provider_payment_id")
  /// Checkout/session id handed to the client (e.g. Stripe `cs_...`).
  providerSessionId  String?          @unique @map("provider_session_id")
  providerCustomerId String?          @map("provider_customer_id")
  /// Raw provider-side status string, kept verbatim for debugging/reconciliation.
  providerStatus     String?          @map("provider_status")
  /// Last full webhook/API payload received for this payment.
  gatewayResponse    Json?            @map("gateway_response") @db.JsonB
  failureReason      String?          @map("failure_reason")

  // ---- Refunds ----
  refundedAmount Decimal?  @map("refunded_amount") @db.Decimal(12, 2)
  refundReason   String?   @map("refund_reason")
  refundedAt     DateTime? @map("refunded_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Both RESTRICT: a payment can never exist without its lease and tenant, and
  // neither parent may be hard-deleted out from under financial history.
  lease  Lease @relation(fields: [leaseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tenant User  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // (tenant_id, status, due_date) backs the tenant payment dashboard
  // ("my unpaid rent, soonest first") and subsumes the plain tenant_id index.
  @@index([leaseId])
  @@index([tenantId, status, dueDate])
  @@index([status])
  @@index([dueDate])
  @@index([provider])
  @@map("rent_payments")
}

// ---------------------------------------------------------------------------
// 16. utility_bills
// ---------------------------------------------------------------------------
model UtilityBill {
  id                 String            @id @default(uuid()) @db.Uuid
  propertyId         String            @map("property_id") @db.Uuid
  unitId             String?           @map("unit_id") @db.Uuid
  type               UtilityType
  billingPeriodStart DateTime          @map("billing_period_start") @db.Timestamptz(6)
  billingPeriodEnd   DateTime          @map("billing_period_end") @db.Timestamptz(6)
  totalAmount        Decimal           @map("total_amount") @db.Decimal(12, 2)
  dueDate            DateTime          @map("due_date") @db.Timestamptz(6)
  status             UtilityBillStatus @default(PENDING)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  unit     Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  splits UtilityBillSplit[]

  @@index([propertyId])
  @@index([unitId])
  @@index([status])
  @@index([billingPeriodStart, billingPeriodEnd])
  @@map("utility_bills")
}

// ---------------------------------------------------------------------------
// 17. utility_bill_splits  ($300 bill -> A $100 / B $100 / C $100)
// ---------------------------------------------------------------------------
model UtilityBillSplit {
  id        String             @id @default(uuid()) @db.Uuid
  billId    String             @map("bill_id") @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  amount    Decimal            @db.Decimal(12, 2)
  status    UtilitySplitStatus @default(PENDING)
  paidAt    DateTime?          @map("paid_at") @db.Timestamptz(6)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  // RESTRICT, not CASCADE: a split is a tenant's financial obligation, so a bill
  // that has already been split cannot be hard-deleted out from under it.
  // The (bill_id, tenant_id) unique both prevents orphan/duplicate splits and
  // serves bill_id lookups, so no separate bill_id index is needed.
  bill   UtilityBill @relation(fields: [billId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tenant User        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([billId, tenantId])
  @@index([tenantId])
  @@index([status])
  @@map("utility_bill_splits")
}
