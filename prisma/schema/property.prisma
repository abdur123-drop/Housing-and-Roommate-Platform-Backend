// ---------------------------------------------------------------------------
// 4. properties
// ---------------------------------------------------------------------------
model Property {
  id           String         @id @default(uuid()) @db.Uuid
  ownerId      String         @map("owner_id") @db.Uuid
  managerId    String?        @map("manager_id") @db.Uuid
  title        String
  description  String?
  propertyType PropertyType   @map("property_type")
  address      String
  city         String
  state        String?
  country      String
  zipCode      String?        @map("zip_code")
  latitude     Decimal?       @db.Decimal(10, 7)
  longitude    Decimal?       @db.Decimal(10, 7)
  status       PropertyStatus @default(DRAFT)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)

  // Financial/rental history must survive an owner deletion -> Restrict.
  // manager_id is the user ASSIGNED to manage this property. It is deliberately
  // not backed by a role: the primary RBAC roles are only OWNER/TENANT/ADMIN.
  // Resource-level authorization for this link is Step 3 work.
  owner   User  @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  manager User? @relation("PropertyManager", fields: [managerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  buildings           Building[]
  viewingRequests     ViewingRequest[]
  utilityBills        UtilityBill[]
  maintenanceRequests MaintenanceRequest[]

  @@index([ownerId])
  @@index([managerId])
  @@index([city])
  @@index([status])
  @@index([deletedAt])
  @@map("properties")
}

// ---------------------------------------------------------------------------
// 5. buildings
// ---------------------------------------------------------------------------
model Building {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @map("property_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  units    Unit[]

  @@unique([propertyId, name])
  @@index([propertyId])
  @@map("buildings")
}

// ---------------------------------------------------------------------------
// 6. units / flats
// ---------------------------------------------------------------------------
model Unit {
  id         String     @id @default(uuid()) @db.Uuid
  buildingId String     @map("building_id") @db.Uuid
  unitNumber String     @map("unit_number")
  floor      Int?
  bedrooms   Int        @default(0)
  bathrooms  Int        @default(0)
  status     UnitStatus @default(AVAILABLE)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?  @map("deleted_at") @db.Timestamptz(6)

  building     Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rooms        Room[]
  utilityBills UtilityBill[]

  @@unique([buildingId, unitNumber])
  @@index([buildingId])
  @@index([status])
  @@map("units")
}

// ---------------------------------------------------------------------------
// 7. rooms
// ---------------------------------------------------------------------------
model Room {
  id              String     @id @default(uuid()) @db.Uuid
  unitId          String     @map("unit_id") @db.Uuid
  roomNumber      String     @map("room_number")
  name            String?
  roomType        RoomType   @map("room_type")
  monthlyRent     Decimal    @map("monthly_rent") @db.Decimal(12, 2)
  securityDeposit Decimal    @default(0) @map("security_deposit") @db.Decimal(12, 2)
  status          RoomStatus @default(AVAILABLE)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  unit                Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  availability        RoomAvailability[]
  viewingRequests     ViewingRequest[]
  applications        Application[]
  leases              Lease[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([unitId, roomNumber])
  @@index([unitId])
  @@index([status])
  @@map("rooms")
}

// ---------------------------------------------------------------------------
// 8. room_availability  (date-ranged; rooms.status is only the "current" flag)
// ---------------------------------------------------------------------------
model RoomAvailability {
  id            String             @id @default(uuid()) @db.Uuid
  roomId        String             @map("room_id") @db.Uuid
  availableFrom DateTime           @map("available_from") @db.Timestamptz(6)
  availableTo   DateTime?          @map("available_to") @db.Timestamptz(6)
  status        AvailabilityStatus @default(AVAILABLE)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?          @map("deleted_at") @db.Timestamptz(6)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([roomId])
  @@index([availableFrom])
  @@index([availableTo])
  @@map("room_availability")
}
