# ---- Runtime ----
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ---- Database (PostgreSQL >= 15) ----
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# ---- Auth ----
BCRYPT_SALT_ROUNDS=10

# Access and refresh tokens MUST use different secrets: if they shared one, a
# refresh token would be accepted as an access token.
# Minimum 32 characters. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to start if either is missing, too short, or identical.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Access tokens are short-lived; revocation relies on them expiring quickly.
JWT_ACCESS_EXPIRES_IN=15m
# Refresh tokens are long-lived but stored (hashed) and individually revocable.
JWT_REFRESH_EXPIRES_IN=30d

# ---- Seed admin (optional; skipped when unset) ----
# ADMIN is not self-assignable through /register - this is the only path to one.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Stripe (Step 14, BDT only) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
